# FireAnalyst Environment Variables

# OpenRouter API Key for chat functionality
DP_API_KEY=your_openrouter_api_key_here

# Google Earth Engine Service Account Credentials (JSON string)
# Option 1: Set this environment variable with the full JSON content
# GEE_PRIVATE_KEY={"type":"service_account","project_id":"..."}

# Option 2: Or place the JSON file at: src/lib/config/severus-457615-83acf40ce029.json
# The app will automatically load it from there if GEE_PRIVATE_KEY is not set

# Server port (optional, defaults to 3000)
PORT=3000
